{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ssrjkk.github.io/agent-skills/roadmaps.schema.json",
  "title": "IT Roadmap Track",
  "description": "One IT direction roadmap. Independent from the skills catalog: edit stages/items by hand, set status to live when the map lands.",
  "type": "object",
  "required": ["slug", "name", "icon", "tagline", "status", "eta", "stages"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "icon": {"type": "string", "minLength": 1},
    "tagline": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["soon", "live"]},
    "eta": {"type": "string", "minLength": 1},
    "catalog_domain": {"type": ["string", "null"]},
    "related_skills": {"type": "array", "items": {"type": "string"}},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "items", "status"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "items": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "status": {"type": "string", "enum": ["soon", "live"]}
        }
      }
    }
  }
}
