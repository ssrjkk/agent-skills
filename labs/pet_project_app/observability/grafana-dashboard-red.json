{
  "title": "Backend API - RED Golden Signals",
  "uid": "backend-api-red",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "RPS (Requests Per Second)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"backend-api\"}[1m])) by (status_code)",
          "legendFormat": "HTTP {{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx Error Rate (%)",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"backend-api\",status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"backend-api\"}[5m])) * 100",
          "legendFormat": "Error %"
        }
      ]
    },
    {
      "id": 3,
      "title": "Application Error Logs (Loki)",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "{service=\"backend-api\"} |= \"error\""
        }
      ]
    }
  ]
}